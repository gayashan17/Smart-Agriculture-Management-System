	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="EADCWAdapter"/>
	<query language="SQL"><![CDATA[SELECT 
    u.name AS farmer_name,
    u.role AS user_role,
    c.crop_name,
    c.category,
    c.planting_date,
    c.harvest_date,
    c.land_size,
    c.quantity,
    c.status
FROM crops c
INNER JOIN users u ON c.farmer_Id = u.id
ORDER BY c.category ASC, c.crop_name ASC;]]></query>
